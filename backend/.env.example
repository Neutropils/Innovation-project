# backend/.env.example
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=             # PostgreSQL connection string, e.g. Supabase: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=               # Production JWT signing secret - use a long random string
DEV_JWT_SECRET=dev-secret-change-me  # Shared dev secret - ALL teammates must use the same value

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
