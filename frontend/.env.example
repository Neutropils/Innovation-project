# Leave blank in development - Vite proxies /api to the backend on port 3000.
# Set to the deployed backend URL in production, e.g. https://my-api.example.com/api
VITE_API_BASE_URL=

# Prototype mode (default): the app answers API calls in the browser with demo data, no backend needed.
# Set to false to use the real backend.
VITE_PROTOTYPE=
